# Qanteak OS RC9 V0.13 runtime configuration.
# GitHub publishing credentials are NOT stored here; publishing uses GitHub CLI keyring auth.

QANTEAK_UPDATE_OWNER=Hqawasmeh
QANTEAK_UPDATE_REPO=CreativeOS-Releases
QANTEAK_UPDATE_CHANNEL=latest
QANTEAK_ALLOW_PRERELEASE=true

# Production backend foundation (publishable key is safe to ship in a desktop client; RLS protects data).
QANTEAK_BACKEND_MODE=supabase
QANTEAK_SUPABASE_URL=https://xohzqpattqeoowadssep.supabase.co
QANTEAK_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Zea_ustLC96qE3TURwemwg_OK6q56y3

# Optional service endpoints.
QANTEAK_AI_ENDPOINT=
QANTEAK_API_BASE_URL=

# Windows code signing. Leave optional for RC testing; set QANTEAK_REQUIRE_SIGNING=1 for production releases.
QANTEAK_REQUIRE_SIGNING=0
# CSC_LINK=C:\path\to\qanteak-code-signing.pfx
# CSC_KEY_PASSWORD=your-local-password

# Google Drive cloud storage is handled by the Supabase Edge Function.
# Add GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and GOOGLE_REFRESH_TOKEN as Supabase Edge Function secrets, not here.
QANTEAK_DRIVE_PROVIDER=google_drive

# Desktop authentication deep links
QANTEAK_AUTH_REDIRECT=qanteak://auth/confirmed
QANTEAK_RECOVERY_REDIRECT=qanteak://auth/recovery
